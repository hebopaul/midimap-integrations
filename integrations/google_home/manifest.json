{
  "format_version": 4,
  "protocol_version": 1,
  "id": "org.midimap.google-home",
  "version": "0.1.8",
  "name": "Google Home",
  "author": "MIDImap development team",
  "description": "Control lights and run automations in a selected Google Home through a host-managed browser session. Development package; Google's private web protocol requires live qualification.",
  "target": "windows-x64",
  "entrypoint": "worker/integration-worker.exe",
  "config_schema_version": 1,
  "config_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "setup": {
    "web_sessions": [
      {
        "id": "google_home",
        "profile": "google_home_web",
        "name": "Google Home"
      }
    ]
  },
  "permissions": [
    {
      "id": "google_home.session",
      "kind": "network.web_session",
      "description": "Use the connected Google Home account to read and control lights and automations in the selected home.",
      "scope": {
        "session": "google_home"
      },
      "required_for_initialization": true
    },
    {
      "id": "google_home.menu",
      "kind": "ui.overlay",
      "description": "Display Google Home controls in the MIDI menu.",
      "scope": {
        "surface": "menu"
      },
      "required_for_initialization": false
    },
    {
      "id": "google_home.toast",
      "kind": "ui.overlay",
      "description": "Show a brief on-screen confirmation when a Google Home control is used.",
      "scope": {
        "surface": "toast"
      },
      "required_for_initialization": false
    }
  ],
  "actions": [
    {
      "id": "set_power",
      "name": "Set light power",
      "description": "Turn the selected light on or off.",
      "permissions": [
        "google_home.session",
        "google_home.toast"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "title": "Light",
            "minLength": 1,
            "maxLength": 128
          },
          "on": {
            "type": "boolean",
            "title": "On"
          }
        },
        "required": [
          "object_id",
          "on"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "object_id",
          "accepted"
        ],
        "additionalProperties": false
      },
      "completion": "Google accepted the light power request; the observed light state is reported separately.",
      "dispatch": {
        "mode": "ordered",
        "key_arguments": [
          "object_id"
        ]
      },
      "feedback": {
        "template": "device",
        "show_on": [
          "intent",
          "success",
          "error",
          "unknown"
        ]
      },
      "target_collection": "lights"
    },
    {
